          "name": "List Notifications",
          "request": {
            "name": "List Notifications",
            "description": {
              "content": "Lists notifications previously dispatched to the issuer, most recent\nfirst.\n\nResults are filterable by event name, delivery status, and a\n`created_at` time range.<br/>\n<b>Required scopes:</b> `notifications:read`",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "issuers",
                ":organizationId",
                "notifications"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page[after]",
                  "value": "<string>",
                  "description": "Represents a cursor value, and if provided, returns the next page of results"
                },
                {
                  "disabled": false,
                  "key": "page[before]",
                  "value": "<string>",
                  "description": "Represents a cursor value, and if provided, returns the previous page of results"
                },
                {
                  "disabled": false,
                  "key": "page[size]",
                  "value": "<integer>",
                  "description": "Maximum number of records to be returned [1 - 200], (default = 200)"
                },
                {
                  "disabled": false,
                  "key": "filter[eventName]",
                  "value": "<string>",
                  "description": "Return only notifications for this event name."
                },
                {
                  "disabled": false,
                  "key": "value",
                  "value": "reference #/components/schemas/type_notifications/notifications:DeliveryStatus not found in the OpenAPI spec",
                  "description": "Return only notifications with this delivery status."
                },
                {
                  "disabled": false,
                  "key": "filter[after]",
                  "value": "<dateTime>",
                  "description": "Return only notifications created strictly after this timestamp (ISO 8601)."
                },
                {
                  "disabled": false,
                  "key": "filter[before]",
                  "value": "<dateTime>",
                  "description": "Return only notifications created strictly before this timestamp (ISO 8601)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "organizationId",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
